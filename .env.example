# ==============================================================================
# Blog Management - Environment Variables Example
# Copy this file to `apps/api/.env` and update credentials for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Backend Server Port
PORT=4000

# PostgreSQL Connection String (Prisma format)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/blog_management_dev?schema=public

# Frontend GraphQL Endpoint URL
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
